rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isOwner() {
      return isAuthenticated() && getUserRole() == 'owner';
    }

    function isStaff() {
      return isAuthenticated() && (getUserRole() == 'staff' || getUserRole() == 'owner');
    }

    function belongsToClinic(clinicId) {
      return isAuthenticated() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.clinicId == clinicId;
    }

    function getUserClinicId() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.clinicId;
    }

    function getClinicPlan(clinicId) {
      return get(/databases/$(database)/documents/subscriptions/$(clinicId)).data.plan;
    }

    // Clinic is operational (read access, existing features)
    function clinicIsActive(clinicId) {
      let sub = get(/databases/$(database)/documents/subscriptions/$(clinicId)).data;
      return sub.status == 'active' || sub.status == 'grace_period';
    }

    // Clinic can make new purchases / add staff (not in grace period)
    function clinicCanExpand(clinicId) {
      return get(/databases/$(database)/documents/subscriptions/$(clinicId)).data.status == 'active';
    }

    // Check if a user's seat is active (for Scenario 6 — session invalidation)
    function isSeatActive(clinicId, userId) {
      return get(/databases/$(database)/documents/seats/$(clinicId)/members/$(userId)).data.active == true;
    }

    // Clinics collection
    match /clinics/{clinicId} {
      allow read: if isAuthenticated() && belongsToClinic(clinicId);
      allow create: if isAuthenticated(); // Owner creates clinic on signup
      allow update: if isOwner() && belongsToClinic(clinicId);
      allow delete: if false; // Clinics are never deleted via client
    }

    // Users collection
    match /users/{userId} {
      allow read: if isAuthenticated() && (
        request.auth.uid == userId ||
        (isOwner() && getUserClinicId() == resource.data.clinicId)
      );
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow update: if isAuthenticated() && (
        request.auth.uid == userId ||
        (isOwner() && getUserClinicId() == resource.data.clinicId)
      );
      allow delete: if false;
    }

    // Subscriptions
    match /subscriptions/{clinicId} {
      allow read: if isAuthenticated() && belongsToClinic(clinicId);
      // TODO [CHALLENGE]: Only allow writes from Cloud Functions (server-side via admin SDK)
      // Hint: check request.auth.token.admin or use a service account claim
      allow write: if false;
    }

    // Add-ons
    match /addons/{clinicId}/items/{addonId} {
      allow read: if isAuthenticated() && belongsToClinic(clinicId);
      // TODO [CHALLENGE]: Only allow writes from Cloud Functions
      allow write: if false;
    }

    // Discounts — readable by owners to display in billing UI
    match /discounts/{discountId} {
      allow read: if isOwner();
      // TODO [CHALLENGE]: Discounts are created server-side. Validate expiry and usage limit before applying.
      allow write: if false;
    }

    // Appointments
    match /appointments/{appointmentId} {
      // Staff must have an active seat to access appointments (Scenario 6)
      allow read: if isAuthenticated() && (
        (isStaff()
          && isSeatActive(getUserClinicId(), request.auth.uid)
          && resource.data.clinicId == getUserClinicId()) ||
        resource.data.patientId == request.auth.uid
      );

      allow create: if isStaff()
        && isSeatActive(getUserClinicId(), request.auth.uid)
        && request.resource.data.clinicId == getUserClinicId();

      allow update: if isStaff()
        && isSeatActive(getUserClinicId(), request.auth.uid)
        && resource.data.clinicId == getUserClinicId();
      allow delete: if isOwner()
        && resource.data.clinicId == getUserClinicId();
    }

    // Seats
    match /seats/{clinicId}/members/{userId} {
      allow read: if isAuthenticated() && belongsToClinic(clinicId);

      // Deactivating a seat is always allowed (needed to resolve downgrade conflicts)
      allow update: if isOwner() && belongsToClinic(clinicId)
        && request.resource.data.active == false;

      // Adding or activating seats: enforce limits, block during grace period and pending downgrade
      allow create: if isOwner() && belongsToClinic(clinicId)
        && clinicCanExpand(clinicId)
        && get(/databases/$(database)/documents/clinics/$(clinicId)).data.seats.used
           < get(/databases/$(database)/documents/clinics/$(clinicId)).data.seats.max
        && !(get(/databases/$(database)/documents/subscriptions/$(clinicId)).data.pendingDowngrade != null);

      allow update: if isOwner() && belongsToClinic(clinicId)
        && request.resource.data.active == true
        && clinicCanExpand(clinicId)
        && get(/databases/$(database)/documents/clinics/$(clinicId)).data.seats.used
           < get(/databases/$(database)/documents/clinics/$(clinicId)).data.seats.max
        && !(get(/databases/$(database)/documents/subscriptions/$(clinicId)).data.pendingDowngrade != null);

      allow delete: if false;
    }
  }
}
