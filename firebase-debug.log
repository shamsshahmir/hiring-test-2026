[debug] [2026-03-29T14:25:38.000Z] >>> [apiv2][body] PUT http://127.0.0.1:8080/emulator/v1/projects/clinic-test-local:securityRules {"ignore_errors":true,"rules":{"files":[{"name":"security.rules","content":"rules_version = '2';\n\nservice cloud.firestore {\n  match /databases/{database}/documents {\n\n    // Helper functions\n    function isAuthenticated() {\n      return request.auth != null;\n    }\n\n    function getUserRole() {\n      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;\n    }\n\n    function isOwner() {\n      return isAuthenticated() && getUserRole() == 'owner';\n    }\n\n    function isStaff() {\n      return isAuthenticated() && (getUserRole() == 'staff' || getUserRole() == 'owner');\n    }\n\n    function belongsToClinic(clinicId) {\n      return isAuthenticated() &&\n        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.clinicId == clinicId;\n    }\n\n    function getClinicPlan(clinicId) {\n      return get(/databases/$(database)/documents/subscriptions/$(clinicId)).data.plan;\n    }\n\n    // Clinic is operational (read access, existing features)\n    function clinicIsActive(clinicId) {\n      let sub = get(/databases/$(database)/documents/subscriptions/$(clinicId)).data;\n      return sub.status == 'active' || sub.status == 'grace_period';\n    }\n\n    // Clinic can make new purchases / add staff (not in grace period)\n    function clinicCanExpand(clinicId) {\n      return get(/databases/$(database)/documents/subscriptions/$(clinicId)).data.status == 'active';\n    }\n\n    // Check if a user's seat is active (for Scenario 6 — session invalidation)\n    function isSeatActive(clinicId, userId) {\n      return get(/databases/$(database)/documents/seats/$(clinicId)/members/$(userId)).data.active == true;\n    }\n\n    // Clinics collection\n    match /clinics/{clinicId} {\n      allow read: if isAuthenticated() && belongsToClinic(clinicId);\n      allow create: if isAuthenticated(); // Owner creates clinic on signup\n      allow update: if isOwner() && belongsToClinic(clinicId);\n      allow delete: if false; // Clinics are never deleted via client\n    }\n\n    // Users collection\n    match /users/{userId} {\n      // Users can read their own profile; owners can read their clinic members\n      allow read: if isAuthenticated() && (\n        request.auth.uid == userId ||\n        isOwner()\n      );\n      allow create: if isAuthenticated() && request.auth.uid == userId;\n      allow update: if isAuthenticated() && (\n        request.auth.uid == userId ||\n        isOwner() // Owner can update roles\n      );\n      allow delete: if false;\n    }\n\n    // Subscriptions\n    match /subscriptions/{clinicId} {\n      allow read: if isAuthenticated() && belongsToClinic(clinicId);\n      // TODO [CHALLENGE]: Only allow writes from Cloud Functions (server-side via admin SDK)\n      // Hint: check request.auth.token.admin or use a service account claim\n      allow write: if false;\n    }\n\n    // Add-ons\n    match /addons/{clinicId}/items/{addonId} {\n      allow read: if isAuthenticated() && belongsToClinic(clinicId);\n      // TODO [CHALLENGE]: Only allow writes from Cloud Functions\n      allow write: if false;\n    }\n\n    // Discounts — readable by owners to display in billing UI\n    match /discounts/{discountId} {\n      allow read: if isOwner();\n      // TODO [CHALLENGE]: Discounts are created server-side. Validate expiry and usage limit before applying.\n      allow write: if false;\n    }\n\n    // Appointments\n    match /appointments/{appointmentId} {\n      allow read: if isAuthenticated() && (\n        // Staff and owners see all clinic appointments\n        isStaff() ||\n        // Patients see only their own\n        resource.data.patientId == request.auth.uid\n      );\n\n      allow create: if isStaff(); // Staff/owner books appointments\n\n      // TODO [CHALLENGE]: Add plan-based access control.\n      // Example: Advanced reporting (analytics on appointments) requires Premium or higher.\n      // Extra Storage add-on required to attach files to appointments.\n\n      allow update: if isStaff();\n      allow delete: if isOwner();\n    }\n\n    // Seats\n    match /seats/{clinicId}/members/{userId} {\n      allow read: if isAuthenticated() && belongsToClinic(clinicId);\n\n      // Deactivating a seat is always allowed (needed to resolve downgrade conflicts)\n      allow update: if isOwner() && belongsToClinic(clinicId)\n        && request.resource.data.active == false;\n\n      // Adding or activating seats: enforce limits and block during pending downgrade\n      allow create: if isOwner() && belongsToClinic(clinicId)\n        && clinicIsActive(clinicId)\n        && get(/databases/$(database)/documents/clinics/$(clinicId)).data.seats.used\n           < get(/databases/$(database)/documents/clinics/$(clinicId)).data.seats.max\n        && !(get(/databases/$(database)/documents/subscriptions/$(clinicId)).data.pendingDowngrade != null);\n\n      allow update: if isOwner() && belongsToClinic(clinicId)\n        && request.resource.data.active == true\n        && clinicIsActive(clinicId)\n        && get(/databases/$(database)/documents/clinics/$(clinicId)).data.seats.used\n           < get(/databases/$(database)/documents/clinics/$(clinicId)).data.seats.max\n        && !(get(/databases/$(database)/documents/subscriptions/$(clinicId)).data.pendingDowngrade != null);\n\n      allow delete: if false;\n    }\n  }\n}\n"}]}}
